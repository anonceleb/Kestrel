{
  "name": "cfp-demo",
  "version": "0.0.1",
  "description": "CFP \u2014 a generic capability-grant primitive for confidential fulfilment, with address and contact as attribute profiles.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/grant-core/*.test.ts tests/profiles/address/*.test.ts tests/profiles/contact/*.test.ts",
    "lint:privacy": "node --experimental-strip-types tools/privacy-lint/lint.ts",
    "verify": "npm run lint:privacy && npm run spec-check && npm run test",
    "demo": "node --experimental-strip-types tools/demo/walkthrough.ts",
    "build:web": "node --experimental-strip-types tools/web-build/build.ts",
    "link-check": "node --experimental-strip-types tools/link-check/check.ts",
    "spec-check": "node --experimental-strip-types tools/spec-check/check.ts"
  }
}
